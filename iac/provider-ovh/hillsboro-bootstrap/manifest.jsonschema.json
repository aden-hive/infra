{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-hive.com/schemas/vm-migration/manifest.v1.json",
  "title": "VM migration backup manifest",
  "description": "Every archive produced by archive.sh MUST match this shape. restore.sh refuses to run against a manifest that fails validation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "source_hostname", "source_public_ipv4", "created_at", "infra_git_rev", "artifacts", "restore_order"],
  "properties": {
    "version": {
      "type": "string",
      "const": "1",
      "description": "Schema version. Bump this and evolve the schema in-place; don't fork."
    },
    "source_hostname": {
      "type": "string",
      "description": "e.g. ns1008198"
    },
    "source_public_ipv4": {
      "type": "string",
      "pattern": "^\\d{1,3}(\\.\\d{1,3}){3}$",
      "description": "The IPv4 that appears baked into restored configs. restore.sh rewrites this to the new box's IP."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "infra_git_rev": {
      "type": "string",
      "description": "git rev of /home/timothy/aden/infra at archive time. May be 'unknown' if the box's checkout isn't a git repo (VA case)."
    },
    "artifacts": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size_bytes", "sha256", "kind"],
        "properties": {
          "path": {
            "type": "string",
            "description": "Relative to the manifest.json. e.g. 'e2b.pgcustom', 'etc-ovh-e2b.tar.zst.age', 'minio/e2b-templates/'"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$|^dir$",
            "description": "sha256 hex or the literal 'dir' for mirrored trees (mc mirror; per-file verified separately)"
          },
          "kind": {
            "type": "string",
            "enum": [
              "pg_dump",
              "pg_globals",
              "consul_snapshot",
              "nomad_snapshot",
              "redis_rdb",
              "tar_zst",
              "tar_zst_age",
              "minio_mirror",
              "inventory_text"
            ]
          },
          "encrypted": {
            "type": "boolean",
            "default": false,
            "description": "true iff this artifact needs `age -d` before use"
          },
          "restore_target": {
            "type": "string",
            "description": "Absolute path where restore.sh writes this on the new box (or a semantic name like 'db:e2b' for non-file targets)"
          }
        }
      }
    },
    "restore_order": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Ordered list of artifact paths — restore.sh replays in this exact order. First items are prerequisites of later ones (e.g. secrets before app tarballs so decrypted creds are available)."
    },
    "sanity_expectations": {
      "type": "object",
      "additionalProperties": false,
      "description": "Post-restore checks. Values are the numbers the archive observed on VA; restore.sh compares against them and warns on mismatch.",
      "properties": {
        "postgres": {
          "type": "object",
          "properties": {
            "env_builds_count": { "type": "integer", "minimum": 0 },
            "teams_count": { "type": "integer", "minimum": 0 },
            "volumes_count": { "type": "integer", "minimum": 0 }
          }
        },
        "minio": {
          "type": "object",
          "properties": {
            "e2b_templates_object_count": { "type": "integer", "minimum": 0 },
            "oci_registry_object_count": { "type": "integer", "minimum": 0 }
          }
        },
        "consul_kv_prefix_count": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 },
          "description": "prefix (e.g. 'ovh-vinthill-1/') → key count"
        }
      }
    }
  }
}

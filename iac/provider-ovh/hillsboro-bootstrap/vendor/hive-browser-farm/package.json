{
  "name": "hive-browser-farm",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Hosted LinkedIn profile/browser fleet \u2014 scheduler, worker, and profile store.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
